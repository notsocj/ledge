<UserControl x:Class="Ledge.ColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="White" FontSize="12.5">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
      <Button Style="{StaticResource Primary}" Margin="0" Click="Pick_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Glyph}" Text="&#xEF3C;" FontSize="13" Margin="0,0,8,0"/>
          <TextBlock Text="Pick a color"/>
        </StackPanel>
      </Button>
      <TextBlock Text="Click anywhere on screen to copy its hex code. Esc cancels." Style="{StaticResource CaptionText}" Margin="12,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="RecentLabel" DockPanel.Dock="Top" Text="Recent, click to copy again" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
    <WrapPanel x:Name="Swatches"/>
  </DockPanel>
</UserControl>
