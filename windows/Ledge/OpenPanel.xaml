<UserControl x:Class="Ledge.OpenPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ledge"
             Foreground="White" FontSize="12.5">
  <DockPanel Margin="16,12,16,16">
    <!-- The tabs sit together on one faint track, so they read as one control. Each tool's icon is set from
         Tool.Glyph() in code; Home's is here. -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Well}" CornerRadius="15" Padding="2" Margin="0,0,0,10"
            HorizontalAlignment="Left">
      <StackPanel x:Name="Tabs" Orientation="Horizontal" Margin="0,0,-2,0">
        <RadioButton x:Name="HomeTab" Content="Home" Tag="&#xE80F;" Style="{StaticResource Tab}" Checked="Tab_Checked"/>
        <RadioButton x:Name="TimerTab" Content="Timer" Style="{StaticResource Tab}" Checked="Tab_Checked"/>
        <RadioButton x:Name="PortsTab" Content="Ports" Style="{StaticResource Tab}" Checked="Tab_Checked"/>
        <RadioButton x:Name="ClipboardTab" Content="Clipboard" Style="{StaticResource Tab}" Checked="Tab_Checked"/>
        <RadioButton x:Name="ShelfTab" Content="Shelf" Style="{StaticResource Tab}" Checked="Tab_Checked"/>
        <RadioButton x:Name="ColorTab" Content="Color" Style="{StaticResource Tab}" Checked="Tab_Checked"/>
        <RadioButton x:Name="CalendarTab" Content="Calendar" Style="{StaticResource Tab}" Checked="Tab_Checked"/>
      </StackPanel>
    </Border>

    <Grid>
      <!-- Home: what's playing, the battery, keep awake. -->
      <Grid x:Name="HomePage">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Playing">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border x:Name="Artwork" Width="88" Height="88" CornerRadius="12" Background="{StaticResource Well}" VerticalAlignment="Top">
            <TextBlock x:Name="ArtworkGlyph" Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="24" Foreground="{StaticResource Ash}"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,4,12,0">
            <TextBlock x:Name="SongTitle" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="SongArtist" Style="{StaticResource BodyText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="-6,10,0,0">
              <Button Style="{StaticResource Icon}" Click="Previous_Click" ToolTip="Previous">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;"/>
              </Button>
              <Button Style="{StaticResource Icon}" Width="34" Height="34" Click="PlayPause_Click">
                <TextBlock x:Name="PlayPauseGlyph" Style="{StaticResource Glyph}" FontSize="16" Text="&#xE768;"/>
              </Button>
              <Button Style="{StaticResource Icon}" Click="Next_Click" ToolTip="Next">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
        <StackPanel x:Name="NothingPlaying" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,4,24,0">
          <TextBlock Text="Nothing playing" Style="{StaticResource TitleText}"/>
          <TextBlock Text="Play something in Spotify, your browser or any media app and it shows up here."
                     Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock x:Name="ToolsAbove" Visibility="Collapsed" Text="Your tools are in the tabs above."
                   Style="{StaticResource BodyText}" Margin="0,4,24,0"/>

        <StackPanel Grid.Column="1">
          <Border x:Name="NextMeetingCard" Background="{StaticResource Well}" CornerRadius="14" Padding="12,7" Margin="0,0,0,6" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="NextMeetingWhen" Style="{StaticResource LabelText}"/>
              <TextBlock x:Name="NextMeetingTitle" Style="{StaticResource HeadlineText}"/>
            </StackPanel>
          </Border>
          <Border x:Name="BatteryCard" Background="{StaticResource Well}" CornerRadius="14" Padding="12,7" Margin="0,0,0,6">
            <StackPanel>
              <TextBlock Text="Battery" Style="{StaticResource LabelText}"/>
              <TextBlock x:Name="BatteryText" Style="{StaticResource TitleText}"/>
            </StackPanel>
          </Border>
          <ToggleButton x:Name="KeepAwakeToggle" Style="{StaticResource Toggle}" Height="36" HorizontalContentAlignment="Left"
                        Click="KeepAwake_Click" ToolTip="Stops the screen from turning off or the PC from sleeping">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE890;" Margin="0,0,8,0"/>
              <TextBlock x:Name="KeepAwakeText" Text="Keep awake"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </Grid>

      <!-- Timer -->
      <Grid x:Name="TimerPage" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
          <local:TabularText x:Name="TimerText" Style="{StaticResource DisplayText}" HorizontalAlignment="Left"/>
          <TextBlock x:Name="TimerHint" Style="{StaticResource BodyText}"/>
        </StackPanel>
        <StackPanel x:Name="TimerPresets" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource Pill}" Content="5 min" Tag="5" Click="Preset_Click"/>
          <Button Style="{StaticResource Pill}" Content="15 min" Tag="15" Click="Preset_Click"/>
          <Button Style="{StaticResource Pill}" Content="25 min" Tag="25" Click="Preset_Click"/>
        </StackPanel>
        <StackPanel x:Name="TimerControls" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
          <Button x:Name="PauseResume" Style="{StaticResource Pill}" Click="PauseResume_Click"/>
          <Button Style="{StaticResource Pill}" Content="+1 min" Click="AddMinute_Click"/>
          <Button Style="{StaticResource Pill}" Content="Cancel" Click="CancelTimer_Click"/>
        </StackPanel>
      </Grid>

      <!-- Ports -->
      <Grid x:Name="PortsPage" Visibility="Collapsed">
        <DockPanel x:Name="PortsList">
          <TextBlock x:Name="PortsHeader" DockPanel.Dock="Top" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
          <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="-10,0">
            <StackPanel x:Name="PortRows"/>
          </ScrollViewer>
        </DockPanel>
        <StackPanel x:Name="NoPorts" VerticalAlignment="Top" Margin="0,4,0,0">
          <TextBlock Text="Nothing running" Style="{StaticResource TitleText}"/>
          <TextBlock Text="Dev servers you start, like npm run dev, show up here with their port."
                     Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>

      <local:ClipboardPage x:Name="ClipboardView" Visibility="Collapsed"/>
      <local:ShelfPage x:Name="ShelfView" Visibility="Collapsed"/>
      <local:ColorPage x:Name="ColorView" Visibility="Collapsed"/>
      <local:CalendarPage x:Name="CalendarView" Visibility="Collapsed"/>
    </Grid>
  </DockPanel>
</UserControl>
