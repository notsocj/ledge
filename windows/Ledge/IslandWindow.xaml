<Window x:Class="Ledge.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ledge"
        Title="Ledge"
        Width="600" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource Poppins}" FontSize="12.5" Foreground="White">
  <!-- The window is a fixed transparent frame; clicks pass through everywhere except the island. Windows
       has no notch, so the island is a pill floating at the top centre that grows into the open panel. -->
  <Grid x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
    <local:IslandSurface x:Name="Shell" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    <Grid x:Name="IslandContent">
      <!-- Closed, the island's sides show what's going on: a running timer, or what's playing. -->
      <Grid x:Name="Wings" Opacity="0" Margin="7,0,12,0">
        <Border x:Name="WingArt" Width="20" Height="20" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock x:Name="WingGlyph" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Left" Margin="4,0,0,0"/>
        <local:TabularText x:Name="WingText" FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock x:Name="WingRightGlyph" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Right"
                   Foreground="{StaticResource Graphite}" Text="&#xE8D6;"/>
      </Grid>
      <local:NotificationCapsule x:Name="Notification" HorizontalAlignment="Center" VerticalAlignment="Top"/>
      <local:OpenPanel x:Name="OpenView" Opacity="0" IsHitTestVisible="False" Width="560" Height="220"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
      <local:SetupView x:Name="Setup" Opacity="0" IsHitTestVisible="False" Width="560" Height="320"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
  </Grid>
</Window>
