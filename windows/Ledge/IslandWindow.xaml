<Window x:Class="Ledge.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ledge"
        Title="Ledge"
        Width="600" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
  <!-- The window is a fixed transparent frame; clicks pass through everywhere except the island. Windows
       has no notch, so the island is a pill floating at the top centre that grows into the open panel. -->
  <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
          Background="Black" BorderBrush="#14FFFFFF" BorderThickness="1">
    <Grid ClipToBounds="True">
      <!-- Closed, the island's sides show what's going on: a running timer, or what's playing. -->
      <Grid x:Name="Wings" Opacity="0" Margin="7,0,12,0">
        <Border x:Name="WingArt" Width="20" Height="20" CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBlock x:Name="WingGlyph" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Left" Margin="4,0,0,0"/>
        <TextBlock x:Name="WingText" FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock x:Name="WingRightGlyph" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Right"
                   Foreground="{StaticResource Graphite}" Text="&#xE8D6;"/>
      </Grid>
      <Grid x:Name="BannerContent" Opacity="0" Margin="16,0" VerticalAlignment="Center">
        <TextBlock x:Name="BannerTitle" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left"/>
        <TextBlock x:Name="BannerDetail" FontSize="13" Foreground="{StaticResource Graphite}" HorizontalAlignment="Right"/>
      </Grid>
      <local:OpenPanel x:Name="OpenView" Opacity="0" IsHitTestVisible="False" Width="560" Height="220"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
  </Border>
</Window>
