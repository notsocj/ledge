<UserControl x:Class="Ledge.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="White" FontSize="12.5">
  <!-- First-run setup, inside the open island: welcome, what you do, your tools, done. -->
  <DockPanel Margin="20,16,20,16">
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="StepText" Style="{StaticResource LabelText}" Foreground="{StaticResource Ash}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BackButton" Style="{StaticResource Pill}" Content="Back" Click="Back_Click"/>
        <Button x:Name="NextButton" Style="{StaticResource Primary}" Click="Next_Click"/>
      </StackPanel>
    </Grid>

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock x:Name="Heading" Style="{StaticResource HeadingText}"/>
      <TextBlock x:Name="Subheading" Style="{StaticResource BodyText}" Margin="0,2,0,0"/>
    </StackPanel>

    <Grid>
      <UniformGrid x:Name="PersonaCards" Columns="3" Rows="2" Visibility="Collapsed" Margin="-3"/>
      <WrapPanel x:Name="ToolChips" Visibility="Collapsed"/>
      <ToggleButton x:Name="StartAtLoginToggle" Style="{StaticResource Toggle}" Visibility="Collapsed" Height="44"
                    HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="StartAtLoginGlyph" Style="{StaticResource Glyph}" Margin="0,0,10,0"/>
          <TextBlock Text="Start Ledge when you sign in"/>
        </StackPanel>
      </ToggleButton>
    </Grid>
  </DockPanel>
</UserControl>
