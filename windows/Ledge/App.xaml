<Application x:Class="Ledge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ledge"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <Application.Resources>
    <!-- The island is pure black; everything on it is white at a few fixed strengths, as on the Mac.
         The quieter text strengths keep at least 4.5:1 contrast on black. -->
    <SolidColorBrush x:Key="Graphite" Color="#A3FFFFFF"/>
    <SolidColorBrush x:Key="Ash" Color="#75FFFFFF"/>
    <SolidColorBrush x:Key="Rail" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Well" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Live" Color="#30D158"/>
    <SolidColorBrush x:Key="Warning" Color="#FF9F0A"/>
    <!-- Poppins is bundled in Assets/Fonts; "#Poppins" picks the family, and FontWeight picks the file. -->
    <FontFamily x:Key="Poppins">pack://application:,,,/Ledge;component/Assets/Fonts/#Poppins</FontFamily>
    <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Ledge's own F1 mark (not Formula 1's trademarked logo): blocky "F1" with speed lines, slanted
         forward. 52 × 20; tinted like any icon, so it follows the text color it sits in. -->
    <PathGeometry x:Key="F1Mark" Figures="M6.64,4.2 L15.14,4.2 L14.13,6.6 L5.63,6.6 Z M7.7,8.8 L13.2,8.8 L12.2,11.2 L6.7,11.2 Z M8.77,13.4 L11.27,13.4 L10.26,15.8 L7.76,15.8 Z M19.4,0 L24.9,0 L16.5,20 L11.0,20 Z M19.4,0 L40.4,0 L38.22,5.2 L17.22,5.2 Z M15.96,8.2 L31.46,8.2 L29.61,12.6 L14.11,12.6 Z M46.4,0 L51.9,0 L43.5,20 L38.0,20 Z M42.9,0 L46.4,0 L44.47,4.6 L40.97,4.6 Z"/>

    <!-- The winner's champagne: a bottle tipped to spray, with a few bubbles, in a 20 × 20 box. -->
    <DrawingImage x:Key="Champagne">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <!-- An empty square, so the image keeps its 20 × 20 box whatever the bubbles reach. -->
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 L20,0 L20,20 L0,20 Z"/>
          <DrawingGroup>
            <DrawingGroup.Transform><RotateTransform Angle="28" CenterX="10" CenterY="10"/></DrawingGroup.Transform>
            <GeometryDrawing Geometry="M8.6,3.5 L11.4,3.5 L11.4,7 C11.4,8.3 14.2,8.6 14.2,11 L14.2,18 Q14.2,19 13.4,19 L6.6,19 Q5.8,19 5.8,18 L5.8,11 C5.8,8.6 8.6,8.3 8.6,7 Z">
              <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#F4DC9A" Offset="0"/>
                  <GradientStop Color="#D4AE62" Offset="1"/>
                </LinearGradientBrush>
              </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Brush="#F8E7B8" Geometry="M8.2,1.6 Q8.2,1.2 8.6,1.2 L11.4,1.2 Q11.8,1.2 11.8,1.6 L11.8,3.6 L8.2,3.6 Z"/>
            <GeometryDrawing Brush="#4A3A1C" Geometry="M5.8,12.5 L14.2,12.5 L14.2,15.6 L5.8,15.6 Z"/>
          </DrawingGroup>
          <GeometryDrawing Brush="#F8E7B8">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <EllipseGeometry Center="16.6,2.6" RadiusX="1" RadiusY="1"/>
                <EllipseGeometry Center="18.6,5" RadiusX="0.8" RadiusY="0.8"/>
                <EllipseGeometry Center="15.2,0.7" RadiusX="0.7" RadiusY="0.7"/>
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Glyphs}"/>
      <Setter Property="FontSize" Value="14"/>
      <!-- The icon font has one weight; without this a SemiBold button would smear its icon with fake bold. -->
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- The type scale. Weight carries the hierarchy, so the thing that matters reads first:
         Bold for the one big thing on a page, SemiBold for names and values you scan for,
         Medium for rows, tabs and buttons you act on, Regular for supporting text. -->

    <!-- The countdown: the largest thing in the island. Used with TabularText, since Poppins has no fixed-width digits. -->
    <Style x:Key="DisplayText" TargetType="local:TabularText">
      <Setter Property="FontSize" Value="40"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <!-- A page's heading, as in setup. -->
    <Style x:Key="HeadingText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <!-- What something is: the song, an empty page's title, the battery level. -->
    <Style x:Key="TitleText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- A smaller name: an alert's title, the next meeting, a persona. -->
    <Style x:Key="HeadlineText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- One line in a list: a copied snippet, a meeting. -->
    <Style x:Key="RowText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Supporting text under a title: the artist, a process name, an explanation. -->
    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{StaticResource Graphite}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="18"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
    <!-- Small hints beside a page's controls. -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{StaticResource Graphite}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- A small name over a value or a group: "Battery", "Today". Heavier than a caption, so it reads as a label. -->
    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource Graphite}"/>
    </Style>

    <!-- No chrome until hovered, and a slight press-down when clicked. Never takes keyboard focus,
         since the island never takes focus from your app. -->
    <Style x:Key="Quiet" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{StaticResource Rail}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A round button holding a glyph. -->
    <Style x:Key="Icon" TargetType="ButtonBase" BasedOn="{StaticResource Quiet}">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
    </Style>

    <!-- A labelled button on a faint plate. -->
    <Style x:Key="Pill" TargetType="ButtonBase" BasedOn="{StaticResource Quiet}">
      <Setter Property="Background" Value="{StaticResource Well}"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <!-- The one main action on a page: white, so it reads first. -->
    <Style x:Key="Primary" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Plate" Background="White" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Plate" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Plate" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tabs as pills, as on the Mac: the open tab shows its icon and name, the rest shrink to icons.
         The icon goes in Tag, the name in Content (also its tooltip). OpenPanel slides the names open and
         shut, and draws the one selection pill that moves between tabs, so neither is in this template. -->
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Ash}"/>
      <Setter Property="Focusable" Value="False"/>
      <!-- The tabs are split over two tracks; one group name keeps them a single choice. -->
      <Setter Property="GroupName" Value="Tabs"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Plate" Background="Transparent" CornerRadius="13" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- The icon: a Segoe glyph (a string in Tag), or a shape such as the F1 mark (a Geometry in Tag). -->
                <ContentPresenter Content="{TemplateBinding Tag}" VerticalAlignment="Center">
                  <ContentPresenter.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                      <TextBlock Text="{Binding}" Style="{StaticResource Glyph}" FontSize="14"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type Geometry}">
                      <Path Data="{Binding}" Height="10" Stretch="Uniform"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </DataTemplate>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <!-- The name, clipped to a width OpenPanel animates: 0 on closed tabs, the name's own width on the open one.
                     The inner StackPanel lets the name keep its natural width while the clip is narrower. -->
                <Border x:Name="LabelHost" Width="0" ClipToBounds="True">
                  <StackPanel Orientation="Horizontal">
                    <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center" Opacity="0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="{StaticResource Well}"/>
                <Setter Property="Foreground" Value="{StaticResource Graphite}"/>
              </Trigger>
              <!-- After hover, so the open tab keeps its look under the pointer; the pill is its background. -->
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Plate" Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="ToolTip" Value="{x:Null}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Toggle" TargetType="ToggleButton" BasedOn="{StaticResource Quiet}">
      <Setter Property="Background" Value="{StaticResource Well}"/>
      <Setter Property="Foreground" Value="{StaticResource Graphite}"/>
      <Setter Property="Padding" Value="12,0"/>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource Rail}"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
