<UserControl x:Class="Ledge.NotificationCapsule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="364" Height="64" Focusable="False" IsHitTestVisible="False"
             FontFamily="{StaticResource Poppins}" Foreground="White"
             AutomationProperties.LiveSetting="Polite">
  <!-- The live island owns the only shell. This content keeps its natural proportions while it morphs. -->
  <Grid x:Name="Presentation" Opacity="0">
    <Grid Margin="12,0,20,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40"/><ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid Width="40" Height="40" VerticalAlignment="Center">
        <Ellipse Fill="#F5F5F7"/>
        <TextBlock x:Name="BadgeGlyph" Style="{StaticResource Glyph}" FontSize="22" Foreground="Black"/>
        <Ellipse x:Name="BadgeSwatch" Width="30" Height="30" Visibility="Collapsed"/>
      </Grid>
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Style="{StaticResource HeadlineText}" Foreground="White"
                   LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap"/>
        <TextBlock x:Name="DetailText" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                   LineHeight="17" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" Grid.Column="4" FontSize="12.5" FontWeight="SemiBold"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="100"/>
    </Grid>
  </Grid>
</UserControl>
