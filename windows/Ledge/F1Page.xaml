<UserControl x:Class="Ledge.F1Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ledge" Foreground="White">
  <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0">
        <TextBlock x:Name="RaceName" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="CircuitName" FontSize="10" Foreground="{StaticResource Ash}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <TextBlock x:Name="CountdownLabel" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Ash}" HorizontalAlignment="Right"/>
        <local:TabularText x:Name="RaceCountdown" FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>
    <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <TextBlock x:Name="Freshness" FontSize="9" Foreground="{StaticResource Ash}"/>
      <TextBlock FontSize="9" Foreground="{StaticResource Ash}" HorizontalAlignment="Right" ToolTip="Schedule and post-race results from Jolpica">
        <Hyperlink NavigateUri="https://jolpi.ca/" RequestNavigate="Source_Click" Foreground="{StaticResource Ash}">Jolpica</Hyperlink>
      </TextBlock>
    </Grid>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
          <TextBlock Text="Weekend schedule" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Ash}"/>
          <TextBlock x:Name="TimeZoneLabel" FontSize="9" Foreground="{StaticResource Ash}" HorizontalAlignment="Right"/>
        </Grid>
        <Grid>
          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SessionRows"/>
          </ScrollViewer>
          <TextBlock x:Name="ScheduleEmpty" Style="{StaticResource BodyText}" Text="Schedule not published yet." FontSize="11"/>
        </Grid>
      </DockPanel>
      <StackPanel Grid.Column="2">
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBlock Text="Latest podium" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Ash}"/>
          <TextBlock x:Name="PodiumRace" Grid.Column="1" FontSize="9" Foreground="{StaticResource Ash}" TextTrimming="CharacterEllipsis"
                     Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel x:Name="PodiumRows"/>
        <TextBlock x:Name="PodiumEmpty" Style="{StaticResource BodyText}" Text="Awaiting published results." FontSize="11"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
